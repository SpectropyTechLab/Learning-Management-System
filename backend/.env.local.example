# Copy to .env.local for local testing. The real .env.local is Git ignored.
LOCAL_DEV=true
NODE_ENV=development
PORT=5000
JWT_SECRET=replace-with-a-random-64-character-hex-secret
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_KEY=replace-with-the-local-service-role-key-from-supabase-status
JWT_SECRET=replace-with-the-local-jwt-secret-from-supabase-status
STUDIO_RUNTIME_SECRET=replace-with-a-local-runtime-secret-of-at-least-32-characters
CORS_ORIGIN=http://localhost:5100,http://localhost:5173
SUPABASE_BUCKET=local-lms
COMMUNITY_MEDIA_BUCKET=local-lms
TEACHING_SESSION_TRACKER_BUCKET=local-teaching-sessions
STUDIO_DOCUMENTS_BUCKET=sessions-scripts-plans
STUDIO_RESOURCES_BUCKET=studio-resources
EXAM_ATTEMPT_SWEEP_ENABLED=false
