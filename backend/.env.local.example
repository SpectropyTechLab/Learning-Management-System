# Copy to backend/.env for the current production branch, or to backend/.env.local
# after the development configuration loader is released. Never commit real values.
NODE_ENV=development
PORT=5000

DATABASE_URL=postgresql://postgres:replace-me@127.0.0.1:54322/postgres
JWT_SECRET=replace-with-at-least-32-random-characters
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_KEY=replace-with-local-service-role-key

CORS_ORIGIN=http://localhost:5100
SUPABASE_BUCKET=lms-assets
COMMUNITY_MEDIA_BUCKET=community-media
TEACHING_SESSION_TRACKER_BUCKET=teaching-sessions

# Optional authentication and database tuning
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
PG_POOL_MAX=10
PG_CONNECTION_TIMEOUT_MS=15000
EXAM_ATTEMPT_SWEEP_ENABLED=false
