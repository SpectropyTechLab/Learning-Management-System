    "bcryptjs": "^3.0.3",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8",
    "docx": "^9.5.0",
    "dotenv": "^16.3",
    "express": "^4.18",
    "helmet": "^7.0",
    "jsonwebtoken": "^9.0",
    "mammoth": "^1.8.0",
    "mime-types": "^3.0.1",
    "multer": "^2.0.2",
    "node-fetch": "^3.3.2",
    "pg": "^8.16.3",
    "uuid": "^13.0.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "eslint": "^9.36.0",
    "nodemon": "^3.0",
    "prettier": "^3.4.2"
