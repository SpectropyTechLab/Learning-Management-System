{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spectropy.com/schemas/simulation-scene-v1.json",
  "title": "SPECTROPY Declarative Simulation Scene",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "subject", "templateId", "kind", "title", "caption", "speed", "metadata", "parameters", "controls", "options", "scene"],
  "properties": {
    "schema": { "const": "spectropy.simulation.v1" },
    "version": { "const": 1 },
    "subject": { "enum": ["physics", "chemistry", "biology", "mathematics"] },
    "templateId": { "const": "universal-scene" },
    "kind": { "const": "scene" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "caption": { "type": "string", "maxLength": 500 },
    "speed": { "type": "number", "minimum": 0.25, "maximum": 3 },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "required": ["category", "icon"],
      "properties": {
        "category": { "type": "string", "minLength": 2, "maxLength": 60 },
        "icon": {
          "type": "object",
          "additionalProperties": false,
          "required": ["query", "alt", "preferredProvider"],
          "properties": {
            "query": { "type": "string", "minLength": 2, "maxLength": 100 },
            "alt": { "type": "string", "minLength": 2, "maxLength": 160 },
            "preferredProvider": { "enum": ["bioicons", "scidraw", "kitbitz", "fluent-emoji", "noto-emoji"] }
          }
        }
      }
    },
    "parameters": { "type": "object", "additionalProperties": { "type": "number" } },
    "controls": {
      "type": "array", "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["key", "label", "unit", "min", "max", "step", "defaultValue"],
        "properties": {
          "key": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$" },
          "label": { "type": "string", "maxLength": 60 },
          "unit": { "type": "string", "maxLength": 20 },
          "min": { "type": "number" }, "max": { "type": "number" }, "step": { "type": "number", "exclusiveMinimum": 0 }, "defaultValue": { "type": "number" }
        }
      }
    },
    "options": {
      "type": "object",
      "properties": { "vectors": { "type": "boolean" }, "labels": { "type": "boolean" }, "trail": { "type": "boolean" }, "grid": { "type": "boolean" } },
      "additionalProperties": { "type": "boolean" }
    },
    "scene": {
      "type": "object", "additionalProperties": false, "required": ["background", "nodes"],
      "properties": {
        "background": { "type": "string" },
        "nodes": {
          "type": "array", "minItems": 1, "maxItems": 250,
          "items": {
            "type": "object",
            "required": ["id", "type", "x", "y"],
            "properties": {
              "id": { "type": "string", "maxLength": 60 },
              "type": { "enum": ["circle", "ellipse", "rect", "line", "arrow", "text", "wave", "polygon"] },
              "x": { "type": "number", "minimum": -1, "maximum": 2 }, "y": { "type": "number", "minimum": -1, "maximum": 2 },
              "x2": { "type": "number", "minimum": -1, "maximum": 2 }, "y2": { "type": "number", "minimum": -1, "maximum": 2 },
              "width": { "type": "number", "minimum": 0, "maximum": 2 }, "height": { "type": "number", "minimum": 0, "maximum": 2 }, "radius": { "type": "number", "minimum": 0, "maximum": 1 },
              "points": { "type": "array", "maxItems": 80, "items": { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }], "minItems": 2, "maxItems": 2 } },
              "text": { "type": "string", "maxLength": 200 }, "fill": { "type": "string" }, "stroke": { "type": "string" },
              "lineWidth": { "type": "number", "minimum": 1, "maximum": 20 }, "fontSize": { "type": "number", "minimum": 12, "maximum": 80 }, "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
              "motion": {
                "type": "object", "required": ["type", "speed"],
                "properties": { "type": { "enum": ["orbit", "oscillate", "pulse", "rotate", "drift"] }, "speed": { "type": "number", "minimum": -10, "maximum": 10 }, "amplitude": { "type": "number", "minimum": 0, "maximum": 1 }, "axis": { "enum": ["x", "y", "both"] }, "centerX": { "type": "number" }, "centerY": { "type": "number" }, "radius": { "type": "number" }, "phase": { "type": "number" } }
              },
              "bindings": {
                "type": "array", "maxItems": 8,
                "items": { "type": "object", "additionalProperties": false, "required": ["property", "parameter", "outputMin", "outputMax"], "properties": { "property": { "enum": ["x", "y", "x2", "y2", "width", "height", "radius", "opacity", "motionSpeed", "motionAmplitude"] }, "parameter": { "type": "string" }, "outputMin": { "type": "number" }, "outputMax": { "type": "number" } } }
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  }
}
