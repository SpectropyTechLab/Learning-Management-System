    { "key": "concentration", "label": "Reactant concentration", "unit": "mol/L", "min": 0.2, "max": 2, "step": 0.1, "defaultValue": 1 },
    { "key": "activationEnergy", "label": "Activation energy", "unit": "kJ/mol", "min": 20, "max": 100, "step": 1, "defaultValue": 55 }
