    c.beginPath(); c.moveTo(x - 5, y); c.lineTo(x + w + 5, y); c.lineWidth = 3; c.stroke();
    c.strokeStyle = 'rgba(255,255,255,.75)'; c.lineWidth = 3; c.beginPath(); c.moveTo(x + w * .25, y + 10); c.lineTo(x + w * .25, y + h - w * .7); c.stroke();
  }
  beakerP(c, x, y, w, h) { c.beginPath(); c.moveTo(x - 7, y); c.lineTo(x, y + 7); c.lineTo(x, y + h - 9); c.quadraticCurveTo(x, y + h, x + 9, y + h); c.lineTo(x + w - 9, y + h); c.quadraticCurveTo(x + w, y + h, x + w, y + h - 9); c.lineTo(x + w, y); }
