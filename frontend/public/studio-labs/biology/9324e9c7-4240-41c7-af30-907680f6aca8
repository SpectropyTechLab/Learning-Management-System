  leaf(c, x, y, w, h, rot, base, regions) {
    c.save(); this.leafP(c, x, y, w, h, rot); c.fillStyle = base; c.fill(); c.clip(); if (regions) regions(); c.restore();
    this.leafP(c, x, y, w, h, rot); c.strokeStyle = 'rgba(30,60,20,.55)'; c.lineWidth = 2; c.stroke();
    c.save(); c.translate(x, y); c.rotate(rot || 0); c.strokeStyle = 'rgba(30,50,20,.35)'; c.lineWidth = 2; c.beginPath(); c.moveTo(-w / 2 - 30, 0); c.lineTo(w / 2 - 6, 0); c.stroke(); c.lineWidth = 1.2;
    for (let i = 1; i < 6; i++) { const px = -w / 2 + i * w / 6.5; [-1, 1].forEach(sd => { c.beginPath(); c.moveTo(px, 0); c.quadraticCurveTo(px + w / 10, sd * h / 6, px + w / 6, sd * h / 3.2); c.stroke(); }); }
