  }
  tripod(c, x, y, w, h) { c.strokeStyle = '#4a4f4b'; c.lineWidth = 5; c.beginPath(); c.moveTo(x - w / 2, y); c.lineTo(x + w / 2, y); c.moveTo(x - w / 2 + 8, y); c.lineTo(x - w / 2 - 6, y + h); c.moveTo(x + w / 2 - 8, y); c.lineTo(x + w / 2 + 6, y + h); c.stroke(); c.fillStyle = '#9aa09a'; c.fillRect(x - w / 2 - 4, y - 5, w + 8, 4); }
  bub(c, x0, w, y0, y1, t, n, seed, r) { c.strokeStyle = 'rgba(255,255,255,.95)'; c.lineWidth = 1.3; for (let i = 0; i < n; i++) { const h = this.H(i, seed), u = (t * (0.5 + h) + h * 7) % 1, x = x0 + this.H(i, seed + 1) * w + Math.sin(t * 4 + i) * 2, y = y0 - u * (y0 - y1); c.beginPath(); c.arc(x, y, (r || 3) * (0.6 + h * 0.6), 0, 6.283); c.stroke(); } }
  dropper(c, x, y, col, t, dripping) {
    c.fillStyle = 'rgba(255,255,255,.6)'; c.strokeStyle = 'rgba(60,80,90,.7)'; c.lineWidth = 2; c.beginPath(); c.moveTo(x - 6, y); c.lineTo(x - 6, y + 60); c.lineTo(x, y + 74); c.lineTo(x + 6, y + 60); c.lineTo(x + 6, y); c.fill(); c.stroke();
    c.fillStyle = col; c.fillRect(x - 4, y + 30, 8, 30); c.fillStyle = '#2b2f2d'; c.beginPath(); c.roundRect(x - 11, y - 34, 22, 36, 10); c.fill();
