    this.raf = requestAnimationFrame(loop);
  }
  componentWillUnmount() { cancelAnimationFrame(this.raf); }
  componentDidUpdate(p) { try { this.frame(0); } catch (e) {} if ((p.exp !== this.props.exp || p.nonce !== this.props.nonce) && this.props.exp && this.E[this.props.exp]) this.setState({ exp: this.props.exp }); }
