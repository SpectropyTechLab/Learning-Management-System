      urine: [['benedict', "Benedict's (sugar)", 'glucose', '#3d6fc2', 1, '#b8441e', 'Brick-red ppt', 'Stays blue'], ['albumin', 'Heat + acetic acid (albumin)', 'albumin', '#f4f2ea', 1, '#fbfaf6', 'White coagulum', 'Stays clear'], ['sulphur', 'Sulphur powder (bile salts)', 'bile', '#e8d040', 0, null, 'Powder sinks', 'Powder floats'], ['urease', 'Urease + phenol red (urea)', 'urea', '#e8b030', 0, '#e0457a', 'Turns pink', 'Stays yellow']] };
    const smp = s => FS[s.mode].find(x => x[0] === s.smp) || FS[s.mode][0], tst = s => FT[s.mode].find(x => x[0] === s.tst) || FT[s.mode][0];
    E.tests = {
      title: 'Tests for food nutrients & urine analysis', cls: 'Class 6 · Class 9 · Class 11', group: 'Classes 6–8',
      aim: 'To test samples for starch, reducing sugar, protein and fat, and to detect sugar, albumin, bile salts and urea in urine.',
      materials: ['Test tubes & rack', 'Iodine solution', "Benedict's reagent", 'Biuret reagent (CuSO₄ + NaOH)', 'Sudan III', 'Acetic acid', 'Sulphur powder', 'Urease + phenol red', 'Water bath & burner'],
      init: () => ({ mode: 'food', smp: 'potato', tst: 'iodine', st: 0, p: 0, heat: false, drop: 0, res: { food: {}, urine: {} }, err: 0, msg: { t: 'info', s: 'Choose a sample and a test, then add the reagent.' } }),
