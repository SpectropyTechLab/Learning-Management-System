      urine: [['normal', 'Normal urine', '#ecd36e', { urea: 1 }], ['diab', 'Diabetic urine', '#ecd36e', { urea: 1, glucose: 1 }], ['kid', 'Kidney-disease urine', '#ecd36e', { urea: 1, albumin: 1 }], ['jaun', 'Jaundice urine', '#d29a32', { urea: 1, bile: 1 }], ['water', 'Water (control)', '#e3edf0', {}]] };
