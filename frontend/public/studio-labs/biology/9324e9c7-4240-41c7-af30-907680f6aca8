  T(c, s, x, y, o) { o = o || {}; c.font = (o.w || 500) + ' ' + (o.s || 15) + 'px ' + (o.mono ? '"JetBrains Mono", monospace' : '"Instrument Sans", sans-serif'); c.fillStyle = o.c || '#1c211f'; c.textAlign = o.a || 'center'; c.textBaseline = 'middle'; c.fillText(s, x, y); }
  pill(c, s, x, y, bg, fg) { c.font = '600 14px "Instrument Sans", sans-serif'; const w = c.measureText(s).width + 22; c.fillStyle = bg; c.beginPath(); c.roundRect(x - w / 2, y - 14, w, 28, 14); c.fill(); this.T(c, s, x, y, { w: 600, s: 14, c: fg }); }
  line(c, pts, col, w) { c.beginPath(); pts.forEach((p, i) => i ? c.lineTo(p[0], p[1]) : c.moveTo(p[0], p[1])); c.strokeStyle = col; c.lineWidth = w; c.stroke(); }
