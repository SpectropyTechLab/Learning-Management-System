    if (extra) extra(y + h * (1 - lvl)); c.restore();
    this.beakerP(c, x, y, w, h); c.strokeStyle = 'rgba(60,80,90,.75)'; c.lineWidth = 2.5; c.stroke();
    c.strokeStyle = 'rgba(255,255,255,.7)'; c.lineWidth = 3; c.beginPath(); c.moveTo(x + 10, y + 16); c.lineTo(x + 10, y + h - 16); c.stroke();
  }
  burner(c, x, y, t, on) {
    c.fillStyle = '#5f655f'; c.beginPath(); c.roundRect(x - 12, y - 46, 24, 46, 4); c.fill(); c.fillStyle = '#3d423e'; c.beginPath(); c.roundRect(x - 30, y - 8, 60, 10, 3); c.fill();
    if (!on) return; const f = 1 + 0.08 * Math.sin(t * 23) + 0.05 * Math.sin(t * 37);
