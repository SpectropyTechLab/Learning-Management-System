 viva:[['Why is ΔH nearly constant for strong acid–strong base?','The net reaction is always H⁺ + OH⁻ → H₂O.']]},

{id:'equil',g:[11],cat:'Physical Chemistry',title:'Shift in chemical equilibrium',
 aim:'To study the shift in equilibrium by changing concentration of ions (Le Chatelier’s principle).',
 th:'Adding a reactant shifts equilibrium forward; the colour of the product deepens. Diluting shifts the cobalt equilibrium back to the pink aqua complex.',
 eq:'Fe³⁺ + SCN⁻ ⇌ [Fe(SCN)]²⁺ (blood red) · [Co(H₂O)₆]²⁺ (pink) + 4Cl⁻ ⇌ [CoCl₄]²⁻ (blue) + 6H₂O',
 app:'Test tubes (4), FeCl₃, KSCN, CoCl₂, conc. HCl, water',
 meters:[],
 vs:[T('Reference',{c:'#c0392b',a:.45}),T('+ FeCl₃',{c:'#c0392b',a:.45}),T('+ KSCN',{c:'#c0392b',a:.45}),T('CoCl₂ soln',{c:'#e98bb1',a:.55})],
 acts:[
  {t:'Add FeCl₃ to tube 2',r:'#d68a1a',fx:[[1,{c:'#9d0f1a',a:.82}]],o:'Red deepens — equilibrium shifts forward.'},
  {t:'Add KSCN to tube 3',r:'#ffffff',fx:[[2,{c:'#9d0f1a',a:.82}]],o:'Red deepens — equilibrium shifts forward.'},
  {t:'Add conc. HCl to CoCl₂',r:'#eaf4ff',fx:[[3,{c:'#2c3fc9',a:.8,fill:.55}]],o:'Pink turns blue — [CoCl₄]²⁻ forms.'},
  {t:'Add water to CoCl₂ tube',r:C.water,fx:[[3,{c:'#e98bb1',a:.5,fill:.7}]],o:'Blue reverts to pink — equilibrium shifts backward.'}],
 res:'Increasing concentration of a reactant shifts equilibrium in the forward direction; dilution shifts the cobalt equilibrium backward, as predicted by Le Chatelier’s principle.',
 viva:[['State Le Chatelier’s principle.','A system at equilibrium adjusts to counteract any imposed change.']]},

