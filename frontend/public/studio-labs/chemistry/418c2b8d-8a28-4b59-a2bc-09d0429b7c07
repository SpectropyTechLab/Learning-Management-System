 acts:[
  {t:'Connect voltmeter (no salt bridge)',r:'#333333',fx:[[0,{}]],m:{volt:0},o:'0.00 V — circuit incomplete.'},
  {t:'Insert salt bridge',r:'#f2f0e8',fx:[[1,{}]],m:{volt:1.10,bridge:true},o:'EMF = 1.10 V (standard cell).'},
  {t:'Dilute CuSO₄ to 0.01 M',r:C.water,fx:[[1,{c:C.cuso4,a:.3,l:'CuSO₄ (0.01 M)'}]],m:{volt:1.04},o:'EMF falls to 1.04 V.'},
  {t:'Dilute ZnSO₄ to 0.01 M',r:C.water,fx:[[0,{l:'ZnSO₄ (0.01 M)'}]],m:{volt:1.10},o:'EMF rises back to 1.10 V.'}],
