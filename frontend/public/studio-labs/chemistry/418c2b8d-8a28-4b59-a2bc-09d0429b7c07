{id:'titr-naoh',g:[11],cat:'Volumetric Analysis',mode:'titr',title:'Titration: NaOH vs standard oxalic acid',
 aim:'To determine the molarity of NaOH by titrating it against 0.05 M oxalic acid.',
 th:'At the end point, moles of NaOH = 2 × moles of oxalic acid. Phenolphthalein turns from colourless to pink at pH ≈ 8.2.',
 eq:'H₂C₂O₄ + 2NaOH → Na₂C₂O₄ + 2H₂O',
 app:'Burette, pipette (10 mL), conical flask, white tile, stand, 0.05 M oxalic acid, NaOH, phenolphthalein',
 safety:'Read the lower meniscus at eye level. Remove the funnel before titrating.',
 meters:['ph'],
 titr:{bl:'NaOH (unknown)',bc:'#eaf4ff',ba:.25,fl:'10 mL 0.05 M oxalic acid + phenolphthalein',fc:'#eaf4ff',fa:.28,ind:'phph',veq:10.8,flaskAcid:true,endpoint:'Colourless → permanent light pink',
  calc:V=>{const M=2*0.05*10/V;return['M(NaOH) = 2 × M(oxalic) × V(oxalic) / V(NaOH)','= 2 × 0.05 × 10 / '+V.toFixed(2)+' = '+M.toFixed(4)+' M','Strength = '+M.toFixed(4)+' × 40 = '+(M*40).toFixed(2)+' g L⁻¹']}},
 res:'Molarity and strength of NaOH are calculated from the concordant titre value.',
 viva:[['Why is oxalic acid a primary standard?','It is pure, stable and non-hygroscopic.'],['Why is phenolphthalein suitable here?','Its colour change range (8.2–10) lies in the steep part of the weak acid–strong base curve.']]},

{id:'titr-na2co3',g:[11],cat:'Volumetric Analysis',mode:'titr',title:'Titration: Na₂CO₃ vs HCl (methyl orange)',
