  {t:'Calculate ΔH',r:'#cfd8dc',fx:[[0,{}]],o:'q = 100 g × 4.18 J g⁻¹K⁻¹ × 6.7 K = 2.80 kJ for 0.05 mol → ΔH ≈ −56.0 kJ mol⁻¹.'}],
