 titr:{bl:'0.1 M HCl',bc:'#eaf4ff',ba:.25,fl:'10 mL Na₂CO₃ (unknown) + methyl orange',fc:'#f5b800',fa:.55,ind:'mo',veq:12.4,flaskAcid:false,endpoint:'Yellow → orange-red (onion peel)',
  calc:V=>{const M=0.1*V/(2*10);return['M(Na₂CO₃) = M(HCl) × V(HCl) / (2 × V(Na₂CO₃))','= 0.1 × '+V.toFixed(2)+' / (2 × 10) = '+M.toFixed(4)+' M','Strength = '+M.toFixed(4)+' × 106 = '+(M*106).toFixed(2)+' g L⁻¹']}},
