const STOPS=[[0,'#c8102e'],[2,'#e8452c'],[3,'#f07a1f'],[4,'#f6a21a'],[5,'#f2cf1d'],[6,'#d6e02a'],[7,'#5cb848'],[8,'#2e9e6b'],[9,'#2386a8'],[10,'#2b5fb8'],[12,'#3a3aa8'],[14,'#5b2a86']];
